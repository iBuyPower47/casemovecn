{
  "name": "casemove",
  "productName": "CaseMoveCn",
  "version": "2.4.0",
  "description": "Counter-Strike 2 Storage unit manager that helps you move stuff. ",
  "main": ".webpack/main",
  "author": {
    "name": "Nombers",
    "email": "casemovenombers@gmail.com",
    "url": "https://github.com/nombersDev/casemove"
  },
  "contributors": [
    {
      "name": "AaronTarga",
      "url": "https://github.com/AaronTarga/casemove"
    },
    {
    "name": "iBuyPower47",
    "url": "https://github.com/iBuyPower47/casemovecn"
  }
  ],
  "scripts": {
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:main:dev": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.dev.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "rebuild": "cd release/app && npm run electron-rebuild",
    "lint": "cross-env NODE_ENV=development eslint . --cache --ext .js,.jsx,.ts,.tsx",
    "prepare": "node -e \"console.log('skip prepare packaging during local install')\"",
    "prepare:package": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --publish never",
    "package": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --publish always",
    "postinstall": "ts-node .erb/scripts/check-native-dep.js && electron-builder install-app-deps && cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts && opencollective-postinstall",
    "start": "ts-node-dev ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "npm run build:main:dev && cross-env NODE_ENV=development electron ./release/app/dist/main/main.js",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "jest",
    "electron-dev": "electron .",
    "electron-trace": "electron --trace-warnings ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ]
  },
  "build": {
    "productName": "CaseMoveCn",
    "appId": "com.iBuyPower47.CaseMoveCn",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    },
    "moduleNameMapper": {
      "^main/(.*)$": "<rootDir>/src/main/$1",
      "^renderer/(.*)$": "<rootDir>/src/renderer/$1",
      "^shared/(.*)$": "<rootDir>/src/shared/$1",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules"
    ],
    "testPathIgnorePatterns": [
      "release/app/dist"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/release/app/"
    ],
    "setupFiles": [
      "./.erb/scripts/check-build-exists.ts"
    ]
  },
  "devDependencies": {
    "@electron/notarize": "^2.3.0",
    "@heroicons/react": "^1.0.5",
    "@pmmmwh/react-refresh-webpack-plugin": "0.5.1",
    "@svgr/core": "^6.2.0",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.184",
    "@types/node": "^20.19.37",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "@types/terser-webpack-plugin": "^5.0.4",
    "@types/webpack-env": "^1.16.3",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "autoprefixer": "^10.4.27",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^6.3.0",
    "core-js": "^3.19.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.5.0",
    "css-minimizer-webpack-plugin": "^3.1.1",
    "detect-port": "^1.3.0",
    "dotenv": "^16.0.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.2.1",
    "electron-notarize": "^1.1.1",
    "electron-rebuild": "^3.2.9",
    "electron-winstaller": "^5.1.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-erb": "^4.0.3",
    "eslint-plugin-compat": "^3.13.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jest": "^25.2.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-promise": "^5.1.1",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "7.0.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^11.2.6",
    "mini-css-extract-plugin": "^2.4.3",
    "opencollective-postinstall": "^2.0.3",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.8",
    "postcss-loader": "^6.2.0",
    "prettier": "^2.4.1",
    "react-refresh": "^0.10.0",
    "react-refresh-typescript": "^2.0.2",
    "react-test-renderer": "^18.3.1",
    "rimraf": "^3.0.2",
    "sass": "^1.43.4",
    "sass-loader": "^12.3.0",
    "style-loader": "^3.3.1",
    "tailwindcss": "^3.4.19",
    "terser-webpack-plugin": "^5.2.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.2.6",
    "ts-node": "10.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "url-loader": "^4.1.1",
    "webpack": "^5.60.0",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.7.3",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@electron/remote": "^2.0.4",
    "@headlessui/react": "^1.6.6",
    "@hello-pangea/dnd": "^18.0.1",
    "@redux-beacon/google-analytics": "^1.2.3",
    "@reduxjs/toolkit": "^2.2.8",
    "axios": "^0.24.0",
    "bytebuffer": "^5.0.1",
    "chart.js": "^3.8.0",
    "chartjs-plugin-datalabels": "^2.0.0",
    "currency-converter-lt": "^2.0.1",
    "electron-debug": "^3.2.0",
    "electron-dl": "^3.3.0",
    "electron-log": "^4.4.8",
    "electron-store": "^8.0.1",
    "electron-updater": "^4.3.9",
    "fernet": "^0.4.0",
    "find-process": "^1.4.7",
    "globaloffensive": "https://github.com/iBuyPower47/node-globaloffensive.git",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^4.2.0",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.0.11",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "regenerator-runtime": "^0.13.9",
    "steam-session": "^1.9.3",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.2.0",
    "update-electron-app": "^2.0.1",
    "xmldom": "^0.6.0"
  },
  "collective": {
    "url": "https://opencollective.com/electron-react-boilerplate-594"
  },
  "browserslist": [],
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
